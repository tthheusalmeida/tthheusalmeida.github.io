---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Button } from '../components/ui/button';
---

<BaseLayout title="Home | tthheusalmeida">
  <div class="min-h-screen flex flex-col items-center justify-center gap-6 p-8">
    <h1 class="text-4xl font-bold text-foreground">Welcome</h1>
    <p class="text-muted-foreground text-lg">Astro + React + Tailwind + shadcn/ui</p>
    <div class="flex gap-4">
      <Button client:load>Default Button</Button>
      <Button client:load variant="outline">Outline Button</Button>
      <Button client:load variant="secondary">Secondary Button</Button>
    </div>
  </div>
</BaseLayout>
