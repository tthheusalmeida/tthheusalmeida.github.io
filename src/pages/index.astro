---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { BlogHome } from '../components/BlogHome';
import { buildSearchIndex, toRawPosts } from '../lib/searchIndex';
import { stripLangSuffix } from '../lib/utils';

const allPosts = await getCollection('blog');

const posts = allPosts.map((entry) => ({
  title: entry.data.title,
  slug: entry.data.slug,
  date: entry.data.date.toISOString(),
  lang: entry.data.lang,
  tags: entry.data.tags,
  draft: entry.data.draft,
  href: `/blog/${stripLangSuffix(entry.id)}`,
}));

const searchIndex = buildSearchIndex(toRawPosts(allPosts));
---

<BaseLayout title="Blog | Matheus Almeida" searchIndex={searchIndex}>
  <BlogHome client:load posts={posts} />
</BaseLayout>
